POSTGRES_DB=kce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/kce
REDIS_URL=redis://redis:6379/0
KCE_ENGINE_BASE_URL=http://engine-python:8000
KCE_AUTH_API_KEY=demo-key
KCE_INTERNAL_TOKEN=dev-internal-token
DEMO_API_KEY=demo-key
DEMO_PROVIDER=demo_local
DEMO_EXTERNAL_USER_ID=demo-user-1
DEMO_SESSION_ID=demo-session
DEMO_RESOURCE_DIR=/workspace/data/demo-resources
# Any OpenAI-compatible chat endpoint works for answer generation.
# DashScope example: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek example: https://api.deepseek.com
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
# DashScope example: qwen-plus
# DeepSeek example: deepseek-v4-flash
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v3
ANSWER_LLM_ENABLED=false
ANSWER_LLM_TIMEOUT_SECONDS=20
ANSWER_MAX_TOKENS=700
ANSWER_CONTEXT_MAX_CHARS=6000
